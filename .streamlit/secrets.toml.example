# Modelo de secrets (NÃO versionar o secrets.toml real — ele está no .gitignore).
#
# v1 do simulador usa apenas dados mockados e NÃO precisa de secrets.
# Quando houver integração real (API/DB da VistoPred), copie este arquivo para
# .streamlit/secrets.toml (uso local) e/ou cole o conteúdo no painel de
# "Secrets" do app no Streamlit Community Cloud. Acesse no código com st.secrets.
#
# Exemplo:
# [vistopred_api]
# base_url = "https://api.vistopred.com.br"
# api_key = "coloque-sua-chave-aqui"
#
# [database]
# url = "postgresql://usuario:senha@host:5432/pmav"
